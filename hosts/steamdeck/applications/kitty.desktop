[Desktop Entry]
X-KDE-Shortcuts=Meta+T
Version=1.0
Type=Application
Name=kitty
GenericName=Terminal emulator
Comment=Fast, feature-rich, GPU based terminal
TryExec=/home/deck/.local/bin/kitty
